<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Анкета</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            padding-top: 50px;
        }
        .form-container {
            background-color: #fff;
            width: 100%;
            max-width: 500px;
            padding: 20px 30px;
            border: 1px solid #ddd;
        }
        .form-group {
            margin-bottom: 25px;
        }
        label {
            display: block;
            font-weight: bold;
            font-size: 16px;
            color: #333;
            margin-bottom: 5px;
        }
        .hint {
            display: block;
            color: #888;
            font-size: 14px;
            margin-bottom: 8px;
        }
        input[type="text"],
        input[type="email"],
        input[type="url"] {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #ccc;
            border-radius: 3px;
            box-sizing: border-box;
            font-size: 14px;
        }
        .add-link {
            display: inline-block;
            margin-top: 10px;
            color: #4285f4;
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
        }
        
        .add-link:hover {
            text-decoration: underline;
        }
        .submit-btn {
            background-color: #4285f4;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 10px;
            letter-spacing: 0.5px;
        }
        .submit-btn:hover {
            background-color: #3b78e7;
        }
