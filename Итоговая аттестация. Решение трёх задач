<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Цветные прямоугольники Vue</title>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <style>
        .color-block {
            width: 100px;
            height: 100px;
            margin: 10px;
            display: inline-block;
            cursor: pointer;
            border: 2px solid #333;
            border-radius: 8px;
            transition: background-color 0.3s ease;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 50px;
        }
    </style>
</head>
<body>
    <div id="app">
        <div class="container">
            <div
                v-for="(block, index) in blocks"
                :key="index"
                class="color-block"
                :style="{ backgroundColor: block.color }"
                @click="changeColor(index)"
            ></div>
        </div>
    </div>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    blocks: [
                        { color: 'red' },
                        { color: 'green' },
                        { color: 'blue' },
                        { color: 'yellow' },
                        { color: 'purple' }
                    ]
                };
            },
            methods: {
                changeColor(index) {
                    const randomColor = '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0');
                    this.blocks[index].color = randomColor;
                }
            }
        }).mount('#app');
    </script>
</body>
</html>
