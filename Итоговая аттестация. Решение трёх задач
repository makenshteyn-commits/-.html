</head>
<body>
<div class="form-container">
    <form action="#">
        <div class="form-group">
            <label for="name">Имя</label>
            <span class="hint">Полное имя, как оно указано в статьях</span>
            <input type="text" id="name" name="name">
            <a href="#" class="add-link">+ Добавить имя</a>
        </div>
        <div class="form-group">
            <label for="work">Место работы</label>
            <span class="hint">Пример: профессор математики, МГУ им. Ломоносова</span>
            <input type="text" id="work" name="work">
        </div>
        <div class="form-group">
            <label for="email">Электронная почта для подтверждения</label>
            <span class="hint">Пример: kolmogorov@msu.ru</span>
            <input type="email" id="email" name="email">
        </div>
        <div class="form-group">
            <label for="interests">Области интересов</label>
            <span class="hint">Пример: топология, турбулентность, функциональный анализ</span>
            <input type="text" id="interests" name="interests">
        </div>
        <div class="form-group">
            <label for="website">Личная страница (необязательно)</label>
            <span class="hint">Пример: http://www.msu.ru/~kolmogorov</span>
            <input type="url" id="website" name="website">
        </div>
        <button type="submit" class="submit-btn">ДАЛЕЕ</button>
    </form>
</div>
</body>
</html>
// Задание 2
function findMaxSumBlock(str) {
    const blocks = str.split('0').filter(block => block.length > 0);

    if (blocks.length === 0) {
        return null;
    }

    let maxSum = -1;
    let maxBlock = '';

    for (const block of blocks) {
        const sum = block.split('').reduce((acc, digit) => acc + Number(digit), 0);

        if (sum > maxSum) {
            maxSum = sum;
            maxBlock = block;
        }
    }

    return { block: maxBlock, sum: maxSum };
}
