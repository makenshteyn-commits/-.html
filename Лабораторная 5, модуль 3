<template>
  <div id="app">
    <h1>Факты о числах</h1>

    <form @submit.prevent="fetchFact">
      <input
        v-model.number="numberInput"
        type="number"
        placeholder="Введите число"
        required
      />
      <select v-model="category">
        <option value="trivia">Случайный факт</option>
        <option value="math">Математика</option>
        <option value="year">Год</option>
      </select>
      <button type="submit">Поиск</button>
    </form>

    <div v-if="loading" class="loader">Загрузка...</div>

    <div v-if="factText && !loading" class="fact">
      {{ factText }}
    </div>

    <div v-if="errorMessage && !loading" class="error">
      {{ errorMessage }}
    </div>
  </div>
</template>

<script setup>
import { ref } from 'vue'

const numberInput = ref(null)
const category = ref('trivia')
const loading = ref(false)
const factText = ref('')
const errorMessage = ref('')

async function fetchFact() {
  if (numberInput.value === null || numberInput.value === '') return

  loading.value = true
  factText.value = ''
  errorMessage.value = ''

  const type = category.value
  const number = numberInput.value

  try {
    const response = await fetch(`http://numbersapi.com/${number}/${type}?json`)
    if (!response.ok) {
      throw new Error('Ошибка сети')
    }
    const data = await response.json()

    if (data.found) {
      factText.value = data.text
    } else {
      const word = type === 'year' ? 'скучный год' : 'скучное число'
      errorMessage.value = `${number} - ${word}`
    }
  } catch {
    errorMessage.value = 'Не удалось загрузить факт. Проверьте соединение.'
  } finally {
    loading.value = false
  }
}
</script>

